APP_NAME="Aura"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aura
DB_USERNAME=aura_dev
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# production HTTPS: SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Rate limiters (AppServiceProvider — Etapa C §1.7.1)
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_UPLOAD_PER_USER=10
RATE_LIMIT_API_SPA_PER_USER=180
STATEMENT_RETENTION_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=aura_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin (AdminUserSeeder) — trocar em produção
ADMIN_EMAIL=admin@aura.local
ADMIN_PASSWORD=ChangeMeNow!123

# Demo multi-papel (DemoRoleUsersSeeder — só local/development/testing)
DEMO_SUBADMIN_EMAIL=subadmin@aura.local
DEMO_SUBADMIN_PASSWORD=ChangeMeNow!123
DEMO_VISITOR_EMAIL=visitor@aura.local
DEMO_VISITOR_PASSWORD=ChangeMeNow!123
DEMO_TEST_EMAIL=test@aura.local
DEMO_TEST_PASSWORD=ChangeMeNow!123

# Cotas por papel (config/aura.php → RoleLimitsSeeder) — 0 = ilimitado
AURA_LIMIT_UPLOAD_ADMIN=0
AURA_LIMIT_UPLOAD_SUBADMIN=50
AURA_LIMIT_UPLOAD_VISITOR=5
AURA_LIMIT_UPLOAD_TEST=3
AURA_LIMIT_MANUAL_TX_ADMIN=0
AURA_LIMIT_MANUAL_TX_SUBADMIN=0
AURA_LIMIT_MANUAL_TX_VISITOR=20
AURA_LIMIT_MANUAL_TX_TEST=10
AURA_LIMIT_DATE_RANGE_DAYS_ADMIN=0
AURA_LIMIT_DATE_RANGE_DAYS_SUBADMIN=0
AURA_LIMIT_DATE_RANGE_DAYS_VISITOR=90
AURA_LIMIT_DATE_RANGE_DAYS_TEST=60
AURA_LIMIT_GOALS_ADMIN=0
AURA_LIMIT_GOALS_SUBADMIN=20
AURA_LIMIT_GOALS_VISITOR=3
AURA_LIMIT_GOALS_TEST=1
AURA_LIMIT_ALIASES_ADMIN=0
AURA_LIMIT_ALIASES_SUBADMIN=0
AURA_LIMIT_ALIASES_VISITOR=10
AURA_LIMIT_ALIASES_TEST=5
AURA_LIMIT_CREDIT_CARDS_ADMIN=0
AURA_LIMIT_CREDIT_CARDS_SUBADMIN=0
AURA_LIMIT_CREDIT_CARDS_VISITOR=3
AURA_LIMIT_CREDIT_CARDS_TEST=2
AURA_LIMIT_LOANS_ADMIN=0
AURA_LIMIT_LOANS_SUBADMIN=0
AURA_LIMIT_LOANS_VISITOR=5
AURA_LIMIT_LOANS_TEST=3
AURA_ALIAS_RETROACTIVE_LIMIT=500

# Feature flags — rollout gradual (Etapa G / H); false desliga o pilar
AURA_FEATURE_MANUAL_TRANSACTIONS=true
AURA_FEATURE_GOALS=true
AURA_FEATURE_ALIASES=true
AURA_FEATURE_CREDIT_CARD_UPLOAD=true
AURA_FEATURE_ADMIN_USERS=true
# Etapa H — cartões / empréstimos / notificações (default off até cutover)
AURA_FEATURE_CREDIT_CARDS=false
AURA_FEATURE_LOANS=false
AURA_FEATURE_NOTIFICATIONS=false

# Janelas de alerta (dias antes do vencimento) — aura:check-due-dates
AURA_NOTIFY_CARD_DUE_DAYS=3
AURA_NOTIFY_LOAN_DUE_DAYS=3
